# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed

# Raw résumé source docs — may contain PII (phone, address) beyond what's
# intentionally curated into site/content.json for public consumption.
# Never commit these; only the curated JSON is meant to be public.
docs/
*.pid.lock

# Scratch/working files (e.g. personal planning docs, drafts) — never
# meant to be committed or pushed.
/.tmp/*

# DORA metrics scorecard data — regenerated weekly (and on-demand) by
# .github/workflows/dora-metrics.yml straight from the GitHub Actions API
# and written directly to the deployed S3 bucket. Fully reproducible from
# GitHub's own run history at any time, so it's not tracked in git —
# keeping it untracked also means deploy.yml's `aws s3 sync --delete`
# never has a stale committed copy to clobber the live data with (see the
# explicit --exclude for it in deploy.yml regardless, as a second layer
# of protection).
site/dora-metrics.json

# Security scorecard data — same reasoning as dora-metrics.json above,
# regenerated daily by .github/workflows/security-scorecard.yml.
site/security-scorecard.json

# Scratch npm audit report produced by security-scorecard.yml for the
# scorecard script to read; not meant to be committed.
audit-report.json


# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/
jspm_packages/

# Snowpack dependency directory (https://snowpack.dev/)
web_modules/

